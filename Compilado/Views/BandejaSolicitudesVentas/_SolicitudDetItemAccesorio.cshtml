@using AHSECO.CCL.FRONTEND.Core;
@using AHSECO.CCL.COMUN;
@{
    ViewBag.Title = "Detalle de Item";
    var strTipoItem_PRO = ConstantesDTO.CotizacionVentaDetalle.TipoItem.Producto;
    var strTipoItem_ACC = ConstantesDTO.CotizacionVentaDetalle.TipoItem.Accesorio;
    var strTipoItem_SER = ConstantesDTO.CotizacionVentaDetalle.TipoItem.Servicio;
}
<div style="display:none">
    <input type="hidden" id="DA_hdnIdCotDet" value="" />
    <input type="hidden" id="DA_hdnHabilitado" value="" />
    <input type="hidden" id="DA_opcGrilla" value="" />
    <input type="hidden" id="DA_Tipo" value=""/>
    <input type="hidden" id="DA_hdnTipoItem_PRO" value="@strTipoItem_PRO" />
    <input type="hidden" id="DA_hdnTipoItem_ACC" value="@strTipoItem_ACC" />
    <input type="hidden" id="DA_hdnTipoItem_SER" value="@strTipoItem_SER" />
</div>
<div id="modalCotDetItem" style="width:80%" class="modal-dialog modal-lg container-fluid" role="document">
    <!-- Modal content -->
    <div class="modal-content">
        <!-- Modal content header -->
        <div class="modal-header box-header well well-sm" style="padding-bottom: 30px;">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <h4 class="modal-title" id="tituloModal"><i class="fa fa-cubes"></i>Detalle de Producto</h4>
        </div>
        <!-- Modal content body -->
        <div class="modal-body d-flex justify-content-center" align-items-center>
            <form id="formItem" class="d-flex flex-row">
                <div class="row d-flex justify-content-center">
                    <div id="DA_pnlInfoGeneral" class="container-fluid">
                        <fieldset>
                            <legend><b>Informaci&oacute;n General</b></legend>
                            <div id="DA_pnlInfoGeneral_COL01" class="col-md-5">
                                <div class="row container-fluid col-content-middleleft form-group">
                                    <div id="DA_pnlInfoGeneral_Codigo" class="col-md-6">
                                        <div class="col-md-6">
                                            <label for="DA_txtCodigo">C&oacute;digo: </label>
                                        </div>
                                        <div class="col-md-6">
                                            <input disabled placeholder="Ingresar código de producto" type="text" class="form-control input-sm" id="DA_txtCodigo" value="">
                                            <input type="hidden" id="DA_hdnCodigo" value="" />
                                            <input type="hidden" id="DA_hdnCodigoPadre" value="" />
                                        </div>
                                    </div>
                                    <div id="DA_pnlInfoGeneral_Cantidad" class="col-md-6">
                                        <div class="col-md-6 col-content-middlecenter">
                                            <label for="DA_txtCantidad">Cantidad: </label>
                                        </div>
                                        <div class="col-md-6">
                                            <input placeholder="Cantidad" type="number" min="0" maxlength="8" style="text-align:center" class="form-control input-sm" id="DA_txtCantidad" value="">
                                        </div>
                                    </div>
                                </div>
                                <div id="DA_pnlInfoGeneral_Descripcion" class="row container-fluid col-content-middleleft form-group">
                                    <div class="col-md-3">
                                        <label for="DA_txtDescripcion">Descripci&oacute;n: </label>
                                    </div>
                                    <div class="col-md-9">
                                        <textarea disabled placeholder="Ingresar nombre de producto" type="text" rows="2" class="form-control input-sm" id="DA_txtDescripcion" value=""></textarea>
                                    </div>
                                </div>
                               
                            </div>
                            <div class="col-md-1"></div>
                        </fieldset>
                    </div>
                    &nbsp;
                    <div id="DA_pnlCostos" class="container-fluid">
                        <fieldset class="form-group">
                            <legend><b>Informaci&oacute;n de Costos</b></legend>

                            <div id="DA_pnlCostos_GrpValorUnitario" class="row container-fluid col-content-middleleft">
                                <div id="DA_pnlCostos_ValorUnitario" class="col-md-4 col-content-middleleft form-group">
                                    <div id="DA_pnlCostos_ValorUnitario_Etiqueta" class="col-md-4">
                                        <label for="DA_txtValorUnitario">Valor Venta Unitario: </label>
                                    </div>
                                    <div class="col-md-6">
                                        <input placeholder="Ingresar Val. Unt." type="text" maxlength="20" class="form-control input-sm" id="DA_txtValorUnitario" value="" oninput="javascript:app.soloNumeroDecimal_onInput(this)" onfocus="this.value = app.formatearEnteroSinComa(this.value);" onblur="this.value = app.formatearEnteroComa(parseFloat(this.value).toFixed(2));">
                                    </div>
                                </div>
                            </div>

                                <div class="row container-fluid col-content-middleleft">
                                    <div id="DA_pnlCostos_TieneStock" class="col-md-4 col-content-middleleft">
                                        <div class="col-md-5">
                                            <label for="DA_radTieneStock">TIENE STOCK: </label>
                                        </div>
                                        <div class="col-md-2">
                                            <table style="width:100%">
                                                <tr>
                                                    <td><input type="radio" name="DA_radTieneStock" class="input-sm" id="DA_radTieneStock_Si"></td>
                                                    <td style="padding-top:5px"><label>SI</label></td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-2">
                                            <table style="width:100%">
                                                <tr>
                                                    <td><input type="radio" name="DA_radTieneStock" class="input-sm" id="DA_radTieneStock_No"></td>
                                                    <td style="padding-top:5px"><label>NO</label></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div id="DA_pnlCostos_CompraLocal" class="col-md-4 col-content-middleleft">
                                        <div class="col-md-5">
                                            <label for="DA_radCompraLocal">Compra Local: </label>
                                        </div>
                                        <div class="col-md-2">
                                            <table style="width:100%">
                                                <tr>
                                                    <td><input type="radio" name="DA_radCompraLocal" class="input-sm" id="DA_radCompraLocal_Si"></td>
                                                    <td style="padding-top:5px"><label>SI</label></td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-2">
                                            <table style="width:100%">
                                                <tr>
                                                    <td><input type="radio" name="DA_radCompraLocal" class="input-sm" id="DA_radCompraLocal_No"></td>
                                                    <td style="padding-top:5px"><label>NO</label></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div id="DA_pnlCostos_Moneda" class="col-md-4 col-content-middleleft form-group">
                                        <div class="col-md-7" id="divlblMoneda">
                                            <label for="DA_Moneda" style="flex: 0 0 120px">Moneda: </label>
                                        </div>
                                        <div class="col-md-5" id="divMoneda">
                                            <input disabled type="text" class="form-control input-sm" style="text-align:center" id="DA_Moneda" value="">
                                        </div>
                                    </div>
                                </div>
                        </fieldset>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-default btn-sm" type="button" id="DA_btnGuardar"><i class="fa fa-save" aria-hidden="true"></i> Guardar</button>
                        <button class="btn btn-default btn-sm" type="button" id="DA_btnGuardarCosteo" style="display:none;"><i class="fa fa-save" aria-hidden="true"></i> Guardar Costeo</button>
                        <button class="btn btn-danger btn-sm" type="button" id="DA_btnCerrar"><i class="fa fa-plus" aria-hidden="true"></i> Salir</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
