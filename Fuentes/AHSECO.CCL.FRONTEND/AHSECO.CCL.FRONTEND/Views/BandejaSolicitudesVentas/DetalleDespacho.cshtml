@using AHSECO.CCL.FRONTEND.Core;

@{
    ViewBag.Title = "Detalle del Despacho";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var numSol = VariableSesion.getCadena("numSol");
    var idCotizacion = VariableSesion.getCadena("idCotizacion");
    var tipoSol = VariableSesion.getCadena("tipoSol");
    var NombreRol = VariableSesion.getCadena("VENTA_NOMBRE_ROL");
    var estadoSol = VariableSesion.getCadena("estadoSol");
}

<input hidden id="IdCotizacion" value="@idCotizacion" />
<input hidden id="NumSol" value="@numSol" />

<div class="container-fluid">
    <h4><i class="fa fa-comment" aria-hidden="true"></i> @ViewBag.Title</h4>

    <div class="box-inner">
        <div class="box-header well" data-original-title="">
            <div style="display: flex;justify-content: space-between;">
                <h2>Detalle del Despacho: </h2> <!--- Aquí tendremos que controlar-->
            </div>
        </div>
        <div class="box-content">
            <div class="container-fluid" style="margin-right: 15px;">
                <div class="box-inner" id="">
                    <div class="box-header well" data-original-title="" style="background-color: #0080ff7a;">
                        <div>
                            <p id="titleCoti"><i class="fa fa-circle-o" aria-hidden="true"></i> Detalle Despacho:</p>
                        </div>
                    </div>
                    <div class="box-content">
                        <div class="row container-fluid">
                            <div class="col-md-4 col-sm-7 col-xs-12">
                                <label for="cmbTipoDespacho">Tipo Despacho: </label>
                                <div class="form-group">
                                    <select class="form-control select2 input-sm" style="width:100%;" id="cmbTipoDespacho" data-selected="">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-12" id="divNumOrden">
                                <label for="txtNumOrden">N° Orden o Contrato:</label>
                                <div class="form-group">
                                    <input placeholder="Número Orden o Contrato" type="text" class="form-control input-sm" id="txtNumOrden" value="">
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-12" id="divContrato" style=" display:none">
                                <label for="txtNumContrato">N° Contrato:</label>
                                <div class="form-group">
                                    <input placeholder="Número Contrato" type="text" class="form-control input-sm" id="txtNumContrato" value="">
                                </div>
                            </div>
                        </div>
                        <div class="row container-fluid">
                            <div class="col-md-4 col-sm-7 col-xs-12">
                                <div class="form-group">
                                    <select disabled class="form-control select2 input-sm" style="width:100%;" id="cmbTipo" data-selected="">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <button class="btn btn-success btn-sm" type="button" id="btnRegistrarDespacho"><i class="fa fa-plus"></i> Nuevo</button>
                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnRegresar" tabindex="14"><i class="fa fa-undo" aria-hidden="true"></i>&nbsp;Regresar</button>
                        </div>
                    </div>
                </div>
                <br />
                <div class="box-inner" id="boxDetalleCotizacion" style="@(ViewBag.PermiteSeleccionarProductos ? "" : "display:none" ) ">
                    <div class="box-header well" data-original-title="" style="background-color: beige;">
                        <div>
                            <p id="titleNomProducto"><i class="fa fa-list" aria-hidden="true" style="color:yellow"></i> Lista Productos</p>
                        </div>
                    </div>
                    <div class="box-content" style="background-color: #f5f5dc30; ">
                        <div class="container-fluid">
                            <div class="table-responsive">
                                <table id="tblDetalleCotizacion" class="table table-hover table-condensed table-striped table-bordered" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center; width: 5%">Todos</th>
                                            <th style="text-align:center; width: 10%">Código Producto</th>
                                            <th style="text-align:center; width: 10%">Descripción</th>
                                            <th style="text-align:center; width: 10%">Cantidad</th>
                                            <th style="text-align:center; width: 10%">Valor Venta Unitario</th>
                                            <th style="text-align:center; width: 10%">Valor. Venta Total Sin IGV (Sin Margen Adicional)</th>
                                            <th style="text-align:center; width: 10%">Margen Adicional(%)</th>
                                            <th style="text-align:center; width: 10%">Valor. Venta Total Sin IGV (Con Margen Adicional)</th>
                                            <th style="text-align:center; width: 5%">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyDetalleCot">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-right">
                                <button style="@(ViewBag.PermiteGuardarProductos ? "" : "display:none") " class="btn btn-success btn-sm" type="button" id="btnRegistrarProductos"><i class="fa fa-plus"></i> Registrar</button>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="box-inner" id="boxDespacho" style="@(ViewBag.PermiteGestionarDespacho ? "" : "display:none")">
                    <div class="box-header well" data-original-title="" style="background-color: beige;">
                        <div>
                            <p id="titleNomProducto"><i class="fa fa-cube" aria-hidden="true" style="color:brown"></i> Despacho</p>
                        </div>
                    </div>
                    <div class="box-content" style="background-color: #f5f5dc30;">
                        <div class="row container-fluid" style="@(ViewBag.VerFacturacion ? "" : "display:none");">
                            <div class="col-md-4 col-sm-12">
                                <label for="txtNumeroFactura">N° de Factura: </label>
                                <div class="form-group">
                                    <input type="text" class="form-control input-sm" maxlength="100" id="txtNumeroFactura" placeholder="Ingresar Número de Factura" @ViewBag.TxtNumFactura>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-12">
                                <label for="dateEntregaPedido">Fecha de Entrega de Pedido: </label>
                                <div class="input-group date">
                                    <input type="text" class="form-control input-sm" id="dateEntregaPedido" aria-describedby="sizing-addon3" placeholder="dd/mm/aaaa" readonly maxlength="10" @ViewBag.FecEntregaPedido>
                                    <span class="input-group-addon input-sm" id="opendateEntregaPedido" @ViewBag.FecEntregaPedido>
                                        <i class="fa fa-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="row container-fluid" style="@(ViewBag.VerObservacionGerencia ? "" : "display:none");">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="txtObservacion">Observaci&oacute;n de Gerencia:</label>
                                    <textarea class="form-control" rows="4" maxlength="1000" id="txtObservacionGerente" disabled>@ViewBag.ObservacionGerencia</textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row container-fluid">
                            <div class="text-right">
                                <button class="btn btn-primary btn-sm" type="button" data-dismiss="modal" id="btnGuiaManuscritaTotal" style="display:@ViewBag.Btn_GuiaManuscritaTotal"><i class="fa fa-file" aria-hidden="true" tabindex="110"></i>&nbsp;Generar Gu&iacute;a Manuscrita</button>
                                <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnEnviarServicio" style="display:@ViewBag.Btn_EnviarServicio"><i class="fa fa-envelope" aria-hidden="true" tabindex="110"></i>&nbsp;Enviar a Facturaci&oacute;n</button>

                                <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnAprobarGestionSS" tabindex="114" style="display:@ViewBag.Btn_Aprobar"><i class="fa fa-handshake-o" aria-hidden="true"></i>&nbsp;Aprobar</button>
                                <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnObservarGestionSS" tabindex="115" style="display:@ViewBag.Btn_Observar"><i class="fa fa-eye" aria-hidden="true"></i>&nbsp;Observar</button>
                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnGuardarGestion" tabindex="116" style="display:@ViewBag.Btn_GuardarDespacho"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar</button>

                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnEditarGestion" tabindex="118" style="display:@ViewBag.Btn_EditarDespacho"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Editar</button>
                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnActualizarGestion" tabindex="119" style="display:none"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar</button>

                                <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnEnviarGuiaTotal" style="display:@ViewBag.Btn_EnviarGuiaTotal"><i class="fa fa-envelope" aria-hidden="true" tabindex="110"></i>&nbsp;Enviar Guia de Pedido</button>
                                <button class="btn btn-primary btn-sm" type="button" data-dismiss="modal" id="btnGuiaPedidoTotal" style="display:@ViewBag.Btn_GuiaPedidoTotal"><i class="fa fa-file" aria-hidden="true" tabindex="113"></i>&nbsp;Generar Gu&iacute;a de Pedido</button>
                                <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnEnviarGuiaBOTotal" style="display:@ViewBag.Btn_EnviarGuiaBOTotal"><i class="fa fa-envelope" aria-hidden="true" tabindex="111"></i>&nbsp;Enviar Guia de BO</button>
                                <button class="btn btn-primary btn-sm" type="button" data-dismiss="modal" id="btnGuiaBOTotal" style="display:@ViewBag.Btn_GuiaBOTotal"><i class="fa fa-file" aria-hidden="true" tabindex="112"></i>&nbsp;Generar Gu&iacute;a de BO</button>


                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnEditarFacturaLogistica" tabindex="123" style="display:@ViewBag.Btn_EditarFacturaLogistica"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Editar Factura</button>
                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnGuardarFacturaLogistica" tabindex="123" style="display:@ViewBag.Btn_GuardarFacturaLogistica"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar Factura</button>
                            </div>
                        </div>
                        <div class="box-content" style="@(ViewBag.VerGestionLogistica ? "" : "display:none");">
                            <ul class="nav nav-tabs" style="padding-top: 5px;">
                                <li class="" id="tabConStock" style="@(ViewBag.VerNavConStock ? "":"display:none");">
                                    <a href="#navConStock" data-toggle="tab" style="font-weight:bold; color:black;" tabindex="221"><i class="fa fa-cubes" aria-hidden="true"></i> Con Stock</a>
                                </li>
                                <li class="" id="tabSinStock" style="@(ViewBag.VerNavSinStock ? "":"display:none");">
                                    <a href="#navSinStock" data-toggle="tab" style="font-weight: bold; color: black;" tabindex="222"><i class="fa fa-wrench" aria-hidden="true"></i> Sin Stock</a>
                                </li>
                                @if (tipoSol == "TSOL01" || tipoSol == "TSOL03")
                                {
                                    <li class="" id="tabServ" style="@(ViewBag.VerNavServicio ? "":"display:none");">
                                        <a href="#navServicio" data-toggle="tab" style="font-weight:bold; color:black;" tabindex="220"><i class="fa fa-user" aria-hidden="true"></i> Servicio</a>
                                    </li>
                                    <li class="" id="tabTecnicos">
                                        <a href="#navTecnicos" data-toggle="tab" style="font-weight: bold; color: #158304;" tabindex="223"><i class="fa fa-users" aria-hidden="true"></i><i class="fa fa-wrench" aria-hidden="true"></i> Tecnicos</a>
                                    </li>
                                }

                            </ul>
                            <div class="tab-content">

                                <div id="navConStock" class="tab-pane fade in active" style="@(ViewBag.VerNavConStock ? "":"display:none");">
                                    <div class="row container-fluid">
                                        &nbsp;
                                    </div>
                                    <div class="row container-fluid">
                                        <div class="text-right">
                                            <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnEnviarGuiaCS" style="display:@ViewBag.Btn_EnviarGuiaCS"><i class="fa fa-envelope" aria-hidden="true" tabindex="110"></i>&nbsp;Enviar Guia de Pedido</button>
                                            <button class="btn btn-primary btn-sm" type="button" data-dismiss="modal" id="btnGuiaPedidoCS" style="display:@ViewBag.Btn_GuiaPedidoCS"><i class="fa fa-file" aria-hidden="true" tabindex="113"></i>&nbsp;Generar Gu&iacute;a de Pedido</button>
                                        </div>
                                    </div>
                                    <div class="row container-fluid">
                                        &nbsp;
                                    </div>
                                    <div class="row container-fluid" id="SeccionLogCS" style="@(ViewBag.SeccionLogCS ? "":"display:none");">

                                        @if (tipoSol == "TSOL04")
                                        {
                                            <div class="col-md-4 col-sm-12">
                                                <label for="txtNumeroGuiaRemisionCE">N° de Gu&iacute;a de Remisi&oacute;n: </label>
                                                <div class="form-group">
                                                    <input type="text" class="form-control input-sm" id="txtNumeroGuiaRemisionCE" maxlength="100" placeholder="Ingresar N° Guia de Remisión" @ViewBag.TxtNumeroGuiaRemisionCE>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="row container-fluid">
                                        <div class="text-right">
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnEditarGestionLogistica" tabindex="120" style="display:@ViewBag.Btn_EditarGestionLogistica"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Editar&nbsp;</button>&nbsp;
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnGuardarGestionLogistica" tabindex="121" style="display:@ViewBag.Btn_GuardarGestionLogistica"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar&nbsp;</button>&nbsp;
                                            @if (tipoSol == "TSOL02" || tipoSol == "TSOL03" || tipoSol == "TSOL05")
                                            {
                                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnRegistrarDespacho" tabindex="121" style="display:@ViewBag.Btn_RegistrarDespacho"><i class="fa fa-truck" aria-hidden="true"></i>&nbsp;Despacho Multiple&nbsp;</button>
                                            }&nbsp;

                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnEnviarGestionDespacho" tabindex="122" style="display:@ViewBag.Btn_EnviarGestionDespacho"><i class="fa fa-envelope" aria-hidden="true"></i>&nbsp;Enviar a Gesti&oacute;n&nbsp;</button>
                                        </div>
                                    </div>
                                    <div class="row container-fluid">
                                        &nbsp;
                                    </div>
                                    @if (tipoSol == "TSOL02" || tipoSol == "TSOL03" || tipoSol == "TSOL05")
                                    {
                                        <div class="row container-fluid">
                                            <div class="table-responsive">
                                                <table id="tblSeriesCS" class="table table-hover table-condensed table-striped table-bordered" width="100%">
                                                    <thead>
                                                        <tr>
                                                            @if (NombreRol == "SGI_VENTA_LOGISTICA" && (estadoSol == "PRVT" || estadoSol == "VTPG"))
                                                            {
                                                                <th style="text-align:center; width:5%; color:white; background-color:cornflowerblue"><input type="checkbox" id="SelTodosCSS" onclick="javascript:seleccionarTodoConStock();" /></th>
                                                            }
                                                            <th style="text-align:center; width:5%; color:white; background-color:cornflowerblue">N°</th>
                                                            <th style="text-align: center; width: 10%; color:white; background-color: cornflowerblue">C&oacute;digo</th>
                                                            <th style="text-align: center; width: 20%; color: white; background-color: cornflowerblue">Descripci&oacute;n Equipo</th>
                                                            <th style="text-align: center; width: 10%; color: white; background-color: cornflowerblue">Marca</th>
                                                            <th style="text-align: center; width: 10%; color: white; background-color: cornflowerblue">Destino</th>
                                                            <th style="text-align: center; width: 15%; color: white; background-color: cornflowerblue">N° Guia Remision</th>
                                                            <th style="text-align: center; width: 15%; color: white; background-color: cornflowerblue">N° Serie / N° Lote</th>
                                                            <th style="text-align: center; width: 10%; color: white; background-color: cornflowerblue">Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr id="NoRegSeries">
                                                            <td align="center" colspan="8">No existen registros</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }


                                </div>
                                <div id="navSinStock" class="tab-pane fade @ViewBag.InActiveSinStock" style="@(ViewBag.VerNavSinStock ? "":"display:none");">
                                    <div class="row container-fluid">
                                        &nbsp;
                                    </div>
                                    <div class="row container-fluid">
                                        <div class="text-right">
                                            <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnEnviarGuiaSS" style="display:@ViewBag.Btn_EnviarGuiaSS"><i class="fa fa-envelope" aria-hidden="true" tabindex="110"></i>&nbsp;Enviar Guia de Pedido</button>
                                            <button class="btn btn-success btn-sm" type="button" data-dismiss="modal" id="btnEnviarGuiaBOSS" style="display:@ViewBag.Btn_EnviarGuiaBO"><i class="fa fa-envelope" aria-hidden="true" tabindex="111"></i>&nbsp;Enviar Guia de BO</button>
                                            <button class="btn btn-primary btn-sm" type="button" data-dismiss="modal" id="btnGuiaBOSS" style="display:@ViewBag.Btn_GuiaBO"><i class="fa fa-file" aria-hidden="true" tabindex="112"></i>&nbsp;Generar Gu&iacute;a de BO</button>
                                            <button class="btn btn-primary btn-sm" type="button" data-dismiss="modal" id="btnGuiaPedidoSS" style="display:@ViewBag.Btn_GuiaPedidoSS"><i class="fa fa-file" aria-hidden="true" tabindex="113"></i>&nbsp;Generar Gu&iacute;a de Pedido</button>
                                        </div>
                                    </div>
                                    <div class="row container-fluid">
                                        &nbsp;
                                    </div>
                                    <div class="row container-fluid" id="SeccionImpSS" style="@(ViewBag.SeccionImpSS ? "":"display:none");">
                                        <div class="col-md-4 col-sm-12">
                                            <label for="txtCodigoPedidoSE">C&oacute;digo de Pedido: </label>
                                            <div class="form-group">
                                                <input type="text" class="form-control input-sm" id="txtCodigoPedidoSE" placeholder="Ingresar Código de Pedido" @ViewBag.TxtCodigoPedido>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-12">
                                            <label for="dateIngresoAlmacenSE">Fecha de Ingreso de Almacen: </label>
                                            <div class="input-group date">
                                                <input type="text" class="form-control input-sm" id="dateIngresoAlmacenSE" aria-describedby="sizing-addon3" placeholder="dd/mm/aaaa" readonly maxlength="10" @ViewBag.IngresoAlmacen>
                                                <span class="input-group-addon input-sm" id="opendateIngresoAlmacenSE" @ViewBag.IngresoAlmacen>
                                                    <i class="fa fa-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row container-fluid" id="SeccionLogSS" style="@(ViewBag.SeccionLogSS ? "":"display:none");">

                                        @if (tipoSol == "TSOL04")
                                        {
                                            <div class="col-md-4 col-sm-12">
                                                <label for="txtNumeroGuiaRemisionSE">N° de Gu&iacute;a de Remisi&oacute;n: </label>
                                                <div class="form-group">
                                                    <input type="text" class="form-control input-sm" id="txtNumeroGuiaRemisionSE" maxlength="100" placeholder="Ingresar N° Guia de Remisión" @ViewBag.TxtNumeroGuiaRemisionSE>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="row container-fluid">
                                        <div class="text-right">
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnActualizarImportacion" tabindex="126" style="display:@ViewBag.Btn_ActualizarImportacion"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Actualizar Importaci&oacute;n</button>
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnGuardarFechaIngresoImportacion" tabindex="126" style="display:@ViewBag.Btn_GuardarFechaIngreso"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar</button>
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnGuardarImportacion" tabindex="126" style="display:@ViewBag.Btn_GuardarImportacion"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar Importaci&oacute;n</button>
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnEditarGestionLogisticaSE" tabindex="127" style="display:@ViewBag.Btn_EditarGestionLogisticaSE"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Editar&nbsp;</button>&nbsp;
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnGuardarGestionLogisticaSE" tabindex="128" style="display:@ViewBag.Btn_GuardarGestionLogisticaSE"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;Guardar&nbsp;</button>&nbsp;
                                            @if (tipoSol == "TSOL02" || tipoSol == "TSOL03" || tipoSol == "TSOL05")
                                            {
                                                <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnRegistrarDespachoSE" tabindex="121" style="display:@ViewBag.Btn_RegistrarDespachoSinStock"><i class="fa fa-truck" aria-hidden="true"></i>&nbsp;Despacho Multiple&nbsp;</button>
                                            }
                                            &nbsp;
                                            <button class="btn btn-info btn-sm" type="button" data-dismiss="modal" id="btnEnviarGestionDespachoSE" tabindex="129" style="display:@ViewBag.Btn_EnviarGestionDespachoSE"><i class="fa fa-envelope" aria-hidden="true"></i>&nbsp;Enviar a Gesti&oacute;n&nbsp;</button>
                                        </div>
                                    </div>
                                    <div class="row container-fluid">
                                        &nbsp;
                                    </div>
                                    @if (tipoSol == "TSOL02" || tipoSol == "TSOL03" || tipoSol == "TSOL05")
                                    {
                                        <div class="row container-fluid">
                                            <div class="table-responsive">
                                                <table id="tblSeriesSS" class="table table-hover table-condensed table-striped table-bordered" width="100%">
                                                    <thead>
                                                        <tr>
                                                            @if (NombreRol == "SGI_VENTA_LOGISTICA" && (estadoSol == "PRVT" || estadoSol == "VTPG"))
                                                            {
                                                                <th style="text-align:center; width:5%; color:white; background-color:cornflowerblue"><input type="checkbox" id="SelTodosSSS" onclick="javascript:seleccionarTodoSinStock();" /></th>
                                                            }
                                                            <th style="text-align:center; width:5%; color:white; background-color:cornflowerblue">N°</th>
                                                            <th style="text-align: center; width: 10%; color:white; background-color: cornflowerblue">C&oacute;digo</th>
                                                            <th style="text-align: center; width: 20%; color: white; background-color: cornflowerblue">Descripci&oacute;n Equipo</th>
                                                            <th style="text-align: center; width: 10%; color: white; background-color: cornflowerblue">Marca</th>
                                                            <th style="text-align: center; width: 10%; color: white; background-color: cornflowerblue">Destino</th>
                                                            <th style="text-align: center; width: 15%; color: white; background-color: cornflowerblue">N° Guia Remision</th>
                                                            <th style="text-align: center; width: 15%; color: white; background-color: cornflowerblue">N° Serie / N° Lote</th>
                                                            <th style="text-align: center; width: 10%; color: white; background-color: cornflowerblue">Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr id="NoRegSeriesSS">
