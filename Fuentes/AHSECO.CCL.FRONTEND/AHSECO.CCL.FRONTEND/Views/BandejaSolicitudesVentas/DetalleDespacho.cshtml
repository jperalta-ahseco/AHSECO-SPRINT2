@using AHSECO.CCL.FRONTEND.Core;

@{
    ViewBag.Title = "Detalle del Despacho";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var numSol = VariableSesion.getCadena("numSol");
    var idCotizacion = VariableSesion.getCadena("idCotizacion");
    var tipoSol = VariableSesion.getCadena("tipoSol");
    var NombreRol = VariableSesion.getCadena("VENTA_NOMBRE_ROL");
    var estadoDesp = VariableSesion.getCadena("estadoDesp");
    var numDespacho = VariableSesion.getCadena("numDespacho");
    var porcentajeDscto = VariableSesion.getCadena("porcentajeDscto");
    var vigencia = VariableSesion.getCadena("vigencia");
    var NombreEstadoDesp = VariableSesion.getCadena("NomestadoDesp");
    var CodigoWorkFlowDesp = VariableSesion.getCadena("CodigoWorkFlowDesp");
    var estadoSol = VariableSesion.getCadena("estadoSol");
    var idFlujo = VariableSesion.getCadena("idFlujo");
