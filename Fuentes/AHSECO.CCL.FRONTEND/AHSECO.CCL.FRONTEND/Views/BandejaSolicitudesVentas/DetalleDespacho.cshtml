                        <label>
                            <input type="checkbox" name="opciones" id="chkPrestacionAccesoria" value="2" disabled>
                            Prestaci&oacute;n Accesoria:
                        </label>
                        <div class="form-group">
                            <input placeholder="Ingresar N° Fianza" type="text" class="form-control input-sm" maxlength="50" id="txtNroFianzaPA" disabled>
                        </div>
                    </div>
                </div>
                <div class="row container-fluid">
                    <div class="text-right">
                        @if (numDespacho != "0")
                        {
                            <button class="btn btn-success btn-sm" type="button" id="btnGuardarCabecera" style="display:@ViewBag.Btn_EditarDespacho"><i class="fa fa-save"></i> Guardar</button>
                        }
