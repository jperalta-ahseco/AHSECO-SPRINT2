<input hidden id="vigencia" value="@vigencia" />
<input hidden id="IdCotizacion" value="@idCotizacion" />
<input hidden id="NumSol" value="@numSol" />
<input hidden id="NumDespacho" value="@numDespacho" />
<input hidden id="ValidaBtnObservacion" value="0" />
<input hidden id="codigoWorkflow" value="@CodigoWorkFlowDesp" />
<input hidden id="estadoDesp" value="@estadoDesp" />
<input hidden id="numeroSolicitud" value="@numSol" />
<input hidden id="TipoSolicitud" value="@tipoSol" />
<input hidden id="FlagStock" value="" />
<input hidden id="idFlujo" value="@idFlujo" />
<input type="hidden" id="EnvioServicio" value="@ViewBag.EnvioServicio" />
<input type="hidden" id="ContadorSeriesCS" value="@ViewBag.ContadorSeriesConStock" />
<input type="hidden" id="TotalSeriesCS" value="@ViewBag.TotalSeriesConStock" />
<input type="hidden" id="ContadorSeriesSS" value="@ViewBag.ContadorSeriesSinStock" />
