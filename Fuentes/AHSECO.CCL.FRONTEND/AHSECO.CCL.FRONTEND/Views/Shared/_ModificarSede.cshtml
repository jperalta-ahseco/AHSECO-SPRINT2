@{
    ViewBag.Title = "Modificacion de Sede";
}

<div class="modal-dialog modal-lg container-fluid" role="document">
    <!-- Modal content -->
    <div class="modal-content">
        <!-- Modal content header -->
        <div class="modal-header box-header well well-sm" style="padding-bottom: 30px;">
            <h4 class="modal-title" id="tituloSedeBandeja">@ViewBag.Title</h4>
        </div>
        <!-- Modal content body -->
        <div class="modal-body d-flex justify-content-center" align-items-center>
            <form id="formRegistro" class="d-flex flex-row">
                <div class="row container-fluid d-flex justify-content-center">
                    <div class="row container-fluid">
                        <div><input hidden id="txtidCliente" value="0"></div>
                    </div>
                    <div class="row container-fluid">
                        <div class="col-md-5 col-sm-12">
                            <div class="form-group">

                                <label class="control-label" for="txtNomSede">Nombre de Sede:</label>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <input maxlength="150" placeholder="Ingrese Nombre de Sede" type="text" class="form-control input-sm" id="txtNomSede" value="">
                            </div>
                        </div>
                    </div>
                   
                   
                   
                    <div class="row container-fluid">
                        <div class="col-md-5 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label for="cmbEstadoSede">Estado:</label>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <select class="form-control select2 input-sm" style="width:100%;" id="cmbEstadoSede">
                                    <option selected value="1">ACTIVO</option>
                                    <option selected value="0">INACTIVO</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="text-right" style="bottom: 10px; position: absolute; right: 10px ">
                        <button class="btn btn-primary btn-sm" type="button" id="btnCerrarSede"><i class="fa fa-times" aria-hidden="true"></i> Cerrar</button>
                        <button class="btn btn-success btn-sm" type="button" id="btnAgregarNuevaSede"><i class="fa fa-plus" aria-hidden="true"></i>Agregar</button>
                        <button class="btn btn-success btn-sm" type="button" id="btnAgregarSede"><i class="fa fa-plus" aria-hidden="true"></i>Agregar</button>
                        <button class="btn btn-success btn-sm" type="button" id="btnActualizarSede"><i class="fa fa-wrench" aria-hidden="true"></i> Actualizar Contacto</button>
                    </div>
                    <br />
                </div>
                <br />
            </form>
        </div>
    </div>
</div>
